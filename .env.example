PORT=3000
# Local MongoDB must run as a single-node replica set for Prisma.
#   mongod --dbpath ~/mongodata-rs --port 27018 --replSet rs0 --bind_ip 127.0.0.1 &
#   mongosh --port 27018 --eval "rs.initiate()"
# Production: Railway internal MongoDB. Reference the Mongo service variables:
#   DATABASE_URL=mongodb://${{MongoDB.MONGOUSER}}:${{MongoDB.MONGOPASSWORD}}@${{MongoDB.MONGOHOST}}:${{MongoDB.MONGOPORT}}/saferide?authSource=admin&replicaSet=rs0&directConnection=true&retryWrites=true
# The Railway Mongo service must run as a replica set (--replSet rs0) because Prisma
# transactions require one. See docs/PHASE_16_DEPLOYMENT.md / Railway MongoDB docs.
DATABASE_URL=mongodb://127.0.0.1:27018/saferide_dev?directConnection=true
# Redis for OTP cache + rate limiting. Leave empty to use the in-memory cache (local dev only).
# Set a real REDIS_URL (e.g. Upstash/Redis Cloud) in production.
REDIS_URL=
FRONTEND_ORIGIN=http://localhost:3001

# JWT / Auth
JWT_ACCESS_TOKEN_SECRET=<random-access-secret>
JWT_REFRESH_TOKEN_SECRET=<random-refresh-secret>
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=30d

# OTP
OTP_EXPIRY_SECONDS=300
OTP_MAX_PER_HOUR=5
OTP_MAX_PER_DAY_PER_IP=20
OTP_MAX_FAILED_ATTEMPTS=5
# When true, the OTP code is returned in the API response for local testing.
SMS_MOCK=true
# When true and no real SMS provider is wired up (SMS_MOCK != 'true'), OTP
# verification auto-succeeds so signup never blocks users. Set to false once a
# real SMS provider is integrated.
OTP_AUTO_VERIFY=true

# Email OTP delivery
# EMAIL_PROVIDER=resend for Resend REST API (requires a verified domain).
# EMAIL_PROVIDER=brevo for Brevo REST API over HTTPS (recommended on Railway;
#   works where outbound SMTP is blocked). Uses the v3 API key (Settings -> API
#   Keys), NOT the SMTP key.
# EMAIL_PROVIDER=smtp for Gmail/Brevo/SendGrid via SMTP (no custom domain needed).
# mock logs the code to the console.
EMAIL_PROVIDER=mock
RESEND_API_KEY=<resend-api-key>
BREVO_API_KEY=<brevo-v3-api-key>
BREVO_SENDER_NAME=SafeRide Kigali
BREVO_SENDER_EMAIL=<verified-brevo-sender-email>
EMAIL_FROM=SafeRide Kigali <no-reply@saferide.rw>
EMAIL_MOCK=true
# SMTP (EMAIL_PROVIDER=smtp). For Gmail, use an app password (2FA enabled) and
# set EMAIL_FROM to the same Gmail address. Port 465 -> SMTP_SECURE=true, 587 -> false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_OTP_EXPIRY_SECONDS=300
EMAIL_OTP_MAX_PER_60S=1
EMAIL_OTP_MAX_PER_HOUR=5
EMAIL_OTP_MAX_FAILED_ATTEMPTS=5
EMAIL_OTP_HASH_SALT=<random-app-level-salt>

# Password reset (email magic-link token)
PASSWORD_RESET_TOKEN_EXPIRY_SECONDS=900
PASSWORD_RESET_MAX_PER_HOUR=5
PASSWORD_RESET_HASH_SALT=<random-app-level-salt>
# Full reset URL override. When empty, falls back to FRONTEND_URL/auth/reset-password.
PASSWORD_RESET_URL=

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_SUBJECT=mailto:ops@saferide.rw

# Web app URLs
# Required. The base URL used to build password-reset links. Local dev uses
# the frontend dev server; production must be the deployed frontend
# (e.g. https://your-frontend.vercel.app) — never localhost in production.
FRONTEND_URL=http://localhost:3001
ADMIN_URL=http://localhost:3001/admin

# Misc / Feature flags
SWAGGER_ENABLED=true
LOG_LEVEL=info

# Google Maps (bring your own key — a real key in this file would be leaked)
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase (FCM) - not used for web push; reserved for mobile later
FCM_SERVICE_ACCOUNT_PATH=/secrets/firebase-service-account.json

# MTN MoMo (sandbox / production credentials - reserved for provider onboarding)
MTN_MOMO_CLIENT_ID=<mtn-client-id>
MTN_MOMO_CLIENT_SECRET=<mtn-client-secret>
MTN_MOMO_SUBSCRIPTION_KEY=<mtn-subscription-key>
MTN_MOMO_CALLBACK_SECRET=<mtn-webhook-secret>

# Airtel Money (sandbox / production credentials)
AIRTEL_CLIENT_ID=<airtel-client-id>
AIRTEL_CLIENT_SECRET=<airtel-client-secret>
AIRTEL_CALLBACK_SECRET=<airtel-webhook-secret>

# S3 / Object Storage (for uploaded documents)
S3_ENDPOINT=<s3-endpoint-or-empty-for-aws>
S3_BUCKET=<bucket-name>
AWS_REGION=<aws-region>
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>

# Sentry
SENTRY_DSN=<your-sentry-dsn-or-empty>

# Prisma / Mongo
# Generate the Prisma client after any schema change: npx prisma generate
# Sync the local schema: npx prisma db push
# Apply migrations in production: npx prisma migrate deploy

# NOTE:
# - Never commit real secrets to source control.
# - Generate VAPID keys with `npx web-push generate-vapid-keys`.
# - The backend (NestJS + WebSockets + background workers) is a long-running
#   service. Deploy it to a VM / container (Render, Fly.io, Railway, Docker) —
#   it does NOT run on Vercel serverless. Only apps/saferide-web deploys to Vercel.
